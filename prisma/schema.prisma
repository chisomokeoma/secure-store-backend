generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum MeasurementUnit {
  METRIC_TON
  KILOGRAM
  METER
  BAG
  UNIT
  LITRE
}

// Phase 1: receipt-tree-ledger refactor.
// Node lifecycle for the immutable UTXO-style receipt tree.
enum ReceiptStatus {
  ACTIVE // live, transactable leaf
  PENDING_APPROVAL // graded by warehouse manager, awaiting approval
  HELD_WITHDRAWAL // reserved by an in-flight withdrawal
  HELD_LOAN // legacy: pledged against a live loan (kept for /loans/*)
  HELD_TRADE // listed on the exchange
  // Collateral flow: volume moved into a "pending pledge" reservation.
  // Client cannot withdraw / trade / re-pledge this volume; financier
  // hasn't decided yet. Transitions to HELD_LIEN on accept or ACTIVE
  // on reject/expire.
  HELD_PLEDGE_PENDING
  // Active lien — financier accepted the pledge. Fully encumbered; only
  // an approved ReleaseRequest (or a Global Admin force-release) can
  // free this volume back to ACTIVE.
  HELD_LIEN
  WITHDRAWN // terminal: physically removed
  TRADED_OUT // terminal: ownership transferred via sale
  SEIZED // terminal: collateral taken on loan default
  EXPIRED // terminal: lapsed
  CANCELLED // terminal: rejected deposit / dead
  SPLIT // superseded internal node (has children)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TxnType {
  DEPOSIT
  WITHDRAWAL
  LOAN
  TRADE
  ADJUSTMENT
  // Collateral flow. Distinct from LOAN so InventoryEvent audit trails
  // for the new /me/pledges → /financier/pledges/:id/accept path don't
  // get confused with the legacy /loans/* module's HELD_LOAN receipts.
  PLEDGE
}

enum InventoryEventType {
  DEPOSIT
  APPROVED
  REJECTED
  HOLD_PLACED
  HOLD_RELEASED
  // Collateral flow: the transition from HELD_PLEDGE_PENDING to HELD_LIEN
  // when a financier accepts a pledge. No volume change (same leaf), just
  // a status flip, so a dedicated event type keeps the audit trail
  // readable without inventing a full split/merge.
  PLEDGE_ACCEPTED
  CONSUMED
  OWNERSHIP_TRANSFERRED
  SEIZED
  EXPIRED
  CANCELLED
  LEGACY_RECONCILIATION
}

enum WithdrawalStatus {
  PENDING_PAYMENT
  PAID_PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  REPAID
  DEFAULTED
  REJECTED
  CANCELLED
}

enum TradeStatus {
  LISTED
  PENDING_SETTLEMENT
  SETTLED
  CANCELLED
}

enum GradingLogic {
  PERCENTAGE
  SCORE
  PASS_FAIL
}

enum FeeType {
  PER_MT_PER_MONTH
  PER_BAG_PER_WEEK
  PER_MT_PER_DAY
  FLAT_RATE
}

enum TransactionOtpPurpose {
  WITHDRAWAL
  LOAN
  TRADE
  DISABLE_2FA
  // CHANGE_PASSWORD is the step-up gate for an in-app password rotation.
  // Required whether or not the user has 2FA enabled — the OTP is the
  // proof-of-mailbox-control that stops anyone with session access (e.g.
  // a WM on a shared kiosk) from quietly changing the client's password.
  CHANGE_PASSWORD
  // Collateral flow: 2FA gates on financier decisions. Accepting a pledge
  // commits the bank's balance sheet as collateral against a real receipt;
  // approving a release lifts that commitment. Both require step-up.
  PLEDGE_ACCEPT
  RELEASE_APPROVE
}

enum NotificationType {
  // Client lifecycle
  CLIENT_REGISTERED
  CLIENT_CREDENTIALS_ISSUED

  // Deposits / receipt approval
  DEPOSIT_PENDING_APPROVAL
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED

  // Withdrawals
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_PAYMENT_CONFIRMED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_DISPATCHED

  // Loans
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_REPAID
  LOAN_DEFAULTED

  // Trades
  TRADE_LISTED
  TRADE_SOLD
  TRADE_CANCELLED

  // Collateral (pledges → liens → releases)
  PLEDGE_CREATED
  PLEDGE_ACCEPTED
  PLEDGE_REJECTED
  PLEDGE_EXPIRED
  RELEASE_REQUESTED
  RELEASE_APPROVED
  RELEASE_REJECTED
  LIEN_FORCE_RELEASED
  // Ambient notifications for financiers: activity in a warehouse they've
  // linked to. `DEPOSIT_LINKED_WAREHOUSE` fires once per deposit into any
  // warehouse where this financier has an ACTIVE link — for the "position
  // is moving" feed. `WITHDRAWAL_BLOCKED_BY_LIEN` fires when a client
  // attempts a withdrawal that would dip into their lien with this financier.
  DEPOSIT_LINKED_WAREHOUSE
  WITHDRAWAL_BLOCKED_BY_LIEN

  // Warehouse-link lifecycle (financier ↔ TA approval flow)
  WAREHOUSE_LINK_REQUESTED
  WAREHOUSE_LINK_APPROVED
  WAREHOUSE_LINK_REJECTED
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// ─── Collateral / financier flow enums ────────────────────────────────────
// Status literals below EXACTLY match src/api/types/collateral.ts on the FE.
// The FE parses these strings verbatim into discriminated union types; any
// rename here breaks the FE's status-badge rendering AND the mutation
// call sites. Do NOT rename without a coordinated FE change.

enum FinancierOrgStatus {
  ACTIVE
  SUSPENDED
}

enum WarehouseLinkStatus {
  PENDING     // Financier submitted onboarding; awaiting TA approval
  ACTIVE      // TA approved; financier can receive pledges from this warehouse
  OFFBOARDED  // Terminated by either party (only allowed when no active liens)
}

enum PledgeStatus {
  PENDING     // Submitted by client; awaiting financier decision
  ACCEPTED    // Financier accepted; a Lien row now exists
  REJECTED    // Financier rejected; volume returned to available
  EXPIRED     // TTL elapsed without decision; volume returned to available
  CANCELLED   // Client withdrew the request (only allowed while PENDING)
}

enum LienStatus {
  ACTIVE              // Fully under lien
  PARTIALLY_RELEASED  // Some volume released via approved ReleaseRequest(s); remainder still liened
  RELEASED            // Fully released (all volume returned to available)
  FORCE_RELEASED      // Global Admin override with court order; terminal
}

enum ReleaseRequestStatus {
  PENDING     // Submitted by client; awaiting financier decision
  APPROVED    // Financier approved; lien decremented, volume freed
  REJECTED    // Financier rejected; volume stays liened
  CANCELLED   // Client withdrew (only allowed while PENDING)
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ClientType {
  FARMER
  TRADER
  COMPANY
  OTHER
}

// Distinguishes the legal nature of the client. INDIVIDUAL clients use the
// classic personal fields on User + ClientProfile; ORGANIZATION clients
// fill in the corporate block (RC number, directors, docs) and the User
// row represents their Authorized Representative.
enum ClientMode {
  INDIVIDUAL
  ORGANIZATION
}

// Company legal structure — straight from the corporate-onboarding form.
// `OTHER` captures the "Provide Detail" free-text via
// `companyCategoryOther` on the profile.
enum CompanyCategory {
  PARTNERSHIP
  PLC
  LLC
  COOPERATIVE
  OTHER
}

enum IdType {
  NIN
  INTERNATIONAL_PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// Document types we accept for a client. Names map 1:1 to the corporate-
// onboarding form's "Required Documentation" list, plus the per-person
// docs (passport photo / ID / utility bill) the rep and directors submit.
enum ClientDocumentType {
  // Company-level (ORGANIZATION mode only)
  CERTIFICATE_OF_INCORPORATION
  MEMORANDUM_AND_ARTICLES
  CAC_FORM_2_OR_7
  CAC_STATUS_REPORT
  TIN_CERTIFICATE
  BOARD_RESOLUTION
  COMPANY_UTILITY_BILL
  // Per-person (Authorized Representative or any Director)
  PASSPORT_PHOTO
  MEANS_OF_ID
  UTILITY_BILL
  // Anything else
  OTHER
}

// Whose document is this? COMPANY = belongs to the org itself.
// REPRESENTATIVE = belongs to the org's authorized rep (the User on the
// ClientProfile). DIRECTOR = belongs to a specific ClientDirector — in
// that case `scopeRefId` carries the director's id.
enum ClientDocumentScope {
  COMPANY
  REPRESENTATIVE
  DIRECTOR
}

// ==========================================
// MODELS
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  warehouses           Warehouse[]
  commodities          Commodity[]
  receipts             Receipt[]
  withdrawals          Withdrawal[]
  loans                Loan[]
  trades               Trade[]
  financiers           Financier[]
  warehouseCommodities WarehouseCommodity[]
  gradingParameters    GradingParameter[]
  storageFeePolicies   StorageFeePolicy[]
  managerAssignments   WarehouseManagerAssignment[]
  activityLogs         ActivityLog[]
  inventoryEvents      InventoryEvent[]
  clientProfiles       ClientProfile[]
  clientFocusCommodities ClientFocusCommodity[]
  clientDirectors      ClientDirector[]
  clientDocuments      ClientDocument[]
  notifications        Notification[]
  clientAttachments    ClientWarehouseAttachment[]
  clientLookupAudits   ClientLookupAudit[]

  // Collateral flow — new entities in the Financier / Pledge / Lien model
  financierOrgs        FinancierOrg[]
  warehouseLinks       WarehouseLink[]
  pledges              Pledge[]
  liens                Lien[]
  releaseRequests      ReleaseRequest[]
  forceReleases        ForceRelease[]
  commodityPrices      CommodityPrice[]

  @@map("tenants")
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  firstName String @map("first_name")
  lastName  String @map("last_name")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roles UserRole[]

  // Profile fields from spec §1.0
  phoneNumber        String?    @map("phone_number")
  middleName         String?    @map("middle_name")
  dateOfBirth        DateTime?  @map("date_of_birth")
  gender             String?
  residentialAddress String?    @map("residential_address")
  employmentDate     DateTime?  @map("employment_date")
  managerCode        String?    @unique @map("manager_code")
  profilePhotoUrl    String?    @map("profile_photo_url")
  contactEmail       String?    @map("contact_email")
  status             UserStatus @default(ACTIVE)
  permissions        Json?
  notificationPrefs  Json?      @map("notification_prefs")

  // Transaction-time security (gated by the user's 2FA toggle):
  //  - `transactionPinHash` is a bcrypt hash of the 4-digit PIN the user
  //    sets in Settings. Required to be present before 2FA can be turned on.
  //  - `twoFactorEnabled` is the master switch. When TRUE, every
  //    withdrawal / loan / trade the user initiates also requires a
  //    fresh OTP delivered to their registered channel.
  transactionPinHash       String?   @map("transaction_pin_hash")
  transactionPinUpdatedAt  DateTime? @map("transaction_pin_updated_at")
  twoFactorEnabled         Boolean   @default(false) @map("two_factor_enabled")
  twoFactorEnabledAt       DateTime? @map("two_factor_enabled_at")

  receipts            Receipt[]
  withdrawals         Withdrawal[]
  loans               Loan[]
  tradesAsSeller      Trade[]                      @relation("TradeSeller")
  tradesAsBuyer       Trade[]                      @relation("TradeBuyer")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  managerAssignments  WarehouseManagerAssignment[] @relation("ManagerAssignments")
  approvedReceipts    Receipt[]                    @relation("ReceiptApprover")
  approvedWithdrawals Withdrawal[]                 @relation("WithdrawalApprover")
  activityLogs        ActivityLog[]
  inventoryEvents     InventoryEvent[]
  clientProfile       ClientProfile?               @relation("ClientUser")
  registeredClients   ClientProfile[]              @relation("ClientRegistrar")
  notifications       Notification[]
  transactionOtps     TransactionOtp[]

  // Multi-warehouse attachments. A client (User with a ClientProfile) can be
  // present in more than one warehouse in the same tenant — attached explicitly
  // by a WM via the lookup+attach flow, not implicit-via-first-receipt.
  clientAttachments   ClientWarehouseAttachment[] @relation("ClientAttachments")
  attachedClients     ClientWarehouseAttachment[] @relation("AttachedByManager")
  detachedClients     ClientWarehouseAttachment[] @relation("DetachedByManager")
  clientLookupAudits  ClientLookupAudit[]         @relation("LookupAuditor")

  // ── Collateral flow ────────────────────────────────────────────────────
  // A user is either a CLIENT (owns receipts, submits pledges/release
  // requests) OR a financier-role user (belongs to a FinancierOrg, decides
  // pledges/releases) OR a WM/TA/GA. The FinancierOrg FK is populated only
  // for financier-role users; every other role has it null.
  financierOrgId      String?                     @map("financier_org_id")
  financierOrg        FinancierOrg?               @relation("FinancierOrgUsers", fields: [financierOrgId], references: [id])

  // Reverse relations for the collateral flow — a client has pledges,
  // liens, and release requests they've submitted; a financier user has
  // decisions they've recorded; a global admin has force-releases.
  clientPledges          Pledge[]         @relation("ClientPledges")
  decidedPledges         Pledge[]         @relation("PledgeDecider")
  clientLiens            Lien[]           @relation("ClientLiens")
  clientReleaseRequests  ReleaseRequest[] @relation("ClientReleaseRequests")
  decidedReleaseRequests ReleaseRequest[] @relation("ReleaseRequestDecider")
  createdWarehouseLinks  WarehouseLink[]  @relation("WarehouseLinkCreator")
  decidedWarehouseLinks  WarehouseLink[]  @relation("WarehouseLinkDecider")
  forceReleases          ForceRelease[]   @relation("ForceReleaseAdmin")
  commodityPricesSet     CommodityPrice[] @relation("PriceSetter")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([financierOrgId])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Warehouse {
  id       String @id @default(uuid())
  name     String
  location String

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Extended fields from spec §1.0
  code       String?         @unique @map("code")
  type       String?
  state      String?
  address    String?
  capacityMt Float?          @map("capacity_mt")
  status     WarehouseStatus @default(ACTIVE)

  // Shared warehouse credential — managers sign in as the warehouse, then
  // identify themselves (which person from the assigned roster did this).
  // `mustChangePassword` flips TRUE whenever a new manager is assigned, so
  // every "inheritance" forces a fresh password on next sign-in (rotating
  // the credential the prior team knew).
  email              String?   @unique
  passwordHash       String?   @map("password_hash")
  passwordSetAt      DateTime? @map("password_set_at")
  mustChangePassword Boolean   @default(true) @map("must_change_password")

  receipts             Receipt[]
  warehouseCommodities WarehouseCommodity[]
  managerAssignments   WarehouseManagerAssignment[]
  storageFeePolicies   StorageFeePolicy[]
  clientAttachments    ClientWarehouseAttachment[]
  clientLookupAudits   ClientLookupAudit[]
  warehouseLinks       WarehouseLink[]
  pledges              Pledge[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("warehouses")
}

model Commodity {
  id            String          @id @default(uuid())
  name          String          @unique
  description   String?
  unitOfMeasure MeasurementUnit @map("unit_of_measure")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Extended fields from spec §1.0
  gradingLogic        GradingLogic @default(PERCENTAGE) @map("grading_logic")
  numberOfGrades      Int          @default(3) @map("number_of_grades")
  code                String?      @unique
  standardBagWeightKg Float?       @map("standard_bag_weight_kg")

  receipts             Receipt[]
  warehouseCommodities WarehouseCommodity[]
  gradingParameters    GradingParameter[]
  storageFeePolicies   StorageFeePolicy[]
  clientFocus          ClientFocusCommodity[]
  prices               CommodityPrice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("commodities")
}

model GradingParameter {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  commodityId String    @map("commodity_id")
  commodity   Commodity @relation(fields: [commodityId], references: [id])

  name        String
  unit        String
  isDefective Boolean @default(false) @map("is_defective")
  thresholds  Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([commodityId, name])
  @@index([tenantId])
  @@index([commodityId])
  @@map("grading_parameters")
}

model StorageFeePolicy {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  warehouseId String?    @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  commodityId String?    @map("commodity_id")
  commodity   Commodity? @relation(fields: [commodityId], references: [id])

  feeType          FeeType          @map("fee_type")
  rate             Float
  billingFrequency BillingFrequency @map("billing_frequency")
  gracePeriodDays  Int              @map("grace_period_days")
  latePenaltyPct   Float            @map("late_penalty_pct")
  currency         String           @default("NGN")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([warehouseId])
  @@index([commodityId])
  @@index([isActive])
  @@map("storage_fee_policies")
}

model WarehouseManagerAssignment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  managerId   String    @map("manager_id")
  manager     User      @relation("ManagerAssignments", fields: [managerId], references: [id])

  assignedAt   DateTime  @default(now()) @map("assigned_at")
  assignedBy   String    @map("assigned_by")
  unassignedAt DateTime? @map("unassigned_at")

  @@unique([warehouseId, managerId])
  @@index([tenantId])
  @@index([managerId])
  @@map("warehouse_manager_assignments")
}

// Immutable UTXO-style node in the receipt tree.
// `quantity` is write-once; state changes mint children + transition status.
// A leaf's available quantity = `quantity` iff status = ACTIVE & approvalStatus = APPROVED.
model Receipt {
  id            String        @id @default(uuid())
  receiptNumber String        @unique @map("receipt_number")
  status        ReceiptStatus @default(PENDING_APPROVAL)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  commodityId String    @map("commodity_id")
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  quantity    Decimal   @db.Decimal(18, 3)
  grade       String?

  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  clientId String @map("client_id")
  client   User   @relation(fields: [clientId], references: [id])

  // Approval workflow (kept as its own field — NOT unified into status)
  approvalStatus       ApprovalStatus @default(PENDING) @map("approval_status")
  approvedById         String?        @map("approved_by_id")
  approvedBy           User?          @relation("ReceiptApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?      @map("approved_at")
  rejectionReason      String?        @map("rejection_reason")
  gradingScores        Json?          @map("grading_scores")
  computedGrade        String?        @map("computed_grade")
  totalDefectivePct    Float?         @map("total_defective_pct")
  standardDeductionPct Float?         @map("standard_deduction_pct")

  // Tree lineage
  parentReceiptId String?   @map("parent_receipt_id")
  parentReceipt   Receipt?  @relation("ReceiptLineage", fields: [parentReceiptId], references: [id])
  childReceipts   Receipt[] @relation("ReceiptLineage")

  rootReceiptId String    @map("root_receipt_id")
  rootReceipt   Receipt   @relation("ReceiptRoot", fields: [rootReceiptId], references: [id])
  descendants   Receipt[] @relation("ReceiptRoot")

  isParent     Boolean   @default(false) @map("is_parent")
  supersededAt DateTime? @map("superseded_at")

  // Provenance — the transaction + ledger event that minted this node
  sourceTxnType TxnType?        @map("source_txn_type")
  sourceTxnId   String?         @map("source_txn_id")
  sourceEventId String?         @map("source_event_id")
  sourceEvent   InventoryEvent? @relation("ReceiptSourceEvent", fields: [sourceEventId], references: [id])
  eventsFrom    InventoryEvent[] @relation("ReceiptEventsFrom")

  dateOfDeposit DateTime  @map("date_of_deposit")
  expiryDate    DateTime? @map("expiry_date")

  withdrawals Withdrawal[]
  loans       Loan[]
  trades      Trade[]

  // Collateral flow reverse relations. `pledges` — the pledges that
  // reference THIS receipt (typically the root receipt visible to the
  // client). `heldForPledge` — if this is the CHILD receipt holding the
  // pledged-pending volume (created by InventoryLedger.hold), the pledge
  // that owns it. `liens` — liens whose receipt is this (post-accept).
  // `releaseLines` — release-request lines targeting this receipt.
  pledges          Pledge[]              @relation("PledgeReceipt")
  heldForPledge    Pledge?               @relation("PledgeHeldReceipt")
  liens            Lien[]
  releaseLines     ReleaseRequestLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([commodityId])
  @@index([warehouseId])
  @@index([status])
  @@index([tenantId])
  @@index([rootReceiptId])
  @@index([parentReceiptId])
  @@index([sourceEventId])
  @@index([tenantId, status])
  @@index([clientId, status, commodityId])
  @@index([status, isParent])
  @@map("receipts")
}

// Append-only inventory ledger. Rows are NEVER updated or deleted.
// The receipt tree is authoritative for reads; this is the audit/retrace log
// and the source for the reconciliation / replay-verify gate.
model InventoryEvent {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  rootReceiptId String   @map("root_receipt_id")
  fromReceiptId String?  @map("from_receipt_id")
  fromReceipt   Receipt? @relation("ReceiptEventsFrom", fields: [fromReceiptId], references: [id])

  eventType InventoryEventType @map("event_type")
  txnType   TxnType?           @map("txn_type")
  txnId     String?            @map("txn_id")
  quantity  Decimal            @db.Decimal(18, 3)

  actorUserId String? @map("actor_user_id")
  actor       User?   @relation(fields: [actorUserId], references: [id])

  idempotencyKey    String?         @unique @map("idempotency_key")
  reversalOfEventId String?         @map("reversal_of_event_id")
  reversalOf        InventoryEvent? @relation("EventReversal", fields: [reversalOfEventId], references: [id])
  reversedBy        InventoryEvent[] @relation("EventReversal")

  createdReceipts Receipt[] @relation("ReceiptSourceEvent")

  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([rootReceiptId])
  @@index([txnType, txnId])
  @@index([tenantId, occurredAt])
  @@index([fromReceiptId])
  @@map("inventory_events")
}

// Depositor KYC profile, 1:1 with a CLIENT-role User. Created by a warehouse
// manager during client registration.
model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation("ClientUser", fields: [userId], references: [id])

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientCode String     @unique @map("client_code")
  type       ClientType @default(FARMER)

  // INDIVIDUAL is the legacy / default path. ORGANIZATION enables the
  // corporate-onboarding fields below + directors[] + documents[].
  mode       ClientMode @default(INDIVIDUAL)

  occupation String?
  description String?

  nationality   String?
  stateOfOrigin String? @map("state_of_origin")
  lga           String?
  nationalId    String? @map("national_id")

  // Nigerian financial-tier identifiers — the two 11-digit numbers issued
  // by NIMC (NIN) and NIBSS (BVN). Discrete columns (not one polymorphic
  // idNumber column) so the multi-warehouse lookup at
  // GET /manager/clients/lookup can index-scan both cheaply. Uniqueness
  // within a tenant is enforced at the application layer during
  // client create + update — Prisma doesn't support @@unique on nullable
  // pairs cleanly, and we specifically want to allow multiple clients
  // with NULL identifiers (many clients simply won't have both).
  nin           String? @map("nin")
  bvn           String? @map("bvn")

  // ── Organization-only fields (NULL when mode = INDIVIDUAL) ──────────────
  rcNumber             String?          @map("rc_number")
  companyName          String?          @map("company_name")
  companyCategory      CompanyCategory? @map("company_category")
  companyCategoryOther String?          @map("company_category_other")
  dateOfIncorporation  DateTime?        @map("date_of_incorporation")
  natureOfBusiness     String?          @map("nature_of_business")
  sectorIndustry       String?          @map("sector_industry")
  businessAddress      String?          @map("business_address")
  tin                  String?

  // ── Authorized Representative (org mode) / additional KYC (individual) ──
  // For ORGANIZATION clients these describe the rep; for INDIVIDUAL clients
  // they're optional self-KYC fields the form may collect.
  representativeDesignation String?        @map("representative_designation")
  otherNames                String?        @map("other_names")
  mothersMaidenName         String?        @map("mothers_maiden_name")
  maritalStatus             MaritalStatus? @map("marital_status")
  idType                    IdType?        @map("id_type")
  idNumber                  String?        @map("id_number")
  idIssueDate               DateTime?      @map("id_issue_date")
  idExpiryDate              DateTime?      @map("id_expiry_date")

  // Multi-focus: a client can target several commodities. Use the
  // `focusCommodities` join below; the legacy single-FK column is dropped
  // in the 20260521_client_focus_commodities migration.
  focusCommodities ClientFocusCommodity[]

  profilePhotoUrl String? @map("profile_photo_url")
  idDocumentUrl   String? @map("id_document_url")

  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankName          String? @map("bank_name")

  nokFullName     String? @map("nok_full_name")
  nokAddress      String? @map("nok_address")
  nokPhone        String? @map("nok_phone")
  nokEmail        String? @map("nok_email")
  nokRelationship String? @map("nok_relationship")

  registeredByManagerId String? @map("registered_by_manager_id")
  registeredByManager   User?   @relation("ClientRegistrar", fields: [registeredByManagerId], references: [id])

  // ORGANIZATION-mode children. Cascade on delete so removing a client
  // takes its directors + documents with it.
  directors ClientDirector[]
  documents ClientDocument[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([registeredByManagerId])
  // Lookup indexes for the "attach existing client" flow. Composite with
  // tenantId to keep the multi-tenant scan bounded.
  @@index([tenantId, nin])
  @@index([tenantId, bvn])
  @@map("client_profiles")
}

// One row per director on an ORGANIZATION-mode client. Mirrors the
// "Director Details + ADD" repeatable section of the corporate-onboarding
// form. INDIVIDUAL clients have no directors; the relation is left empty.
model ClientDirector {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  clientProfileId   String        @map("client_profile_id")
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  firstName          String         @map("first_name")
  lastName           String         @map("last_name")
  otherNames         String?        @map("other_names")
  designation        String?
  residentialAddress String?        @map("residential_address")
  phoneNumber        String?        @map("phone_number")
  email              String?
  mothersMaidenName  String?        @map("mothers_maiden_name")
  gender             String?
  dateOfBirth        DateTime?      @map("date_of_birth")
  nationality        String?
  stateOfOrigin      String?        @map("state_of_origin")
  maritalStatus      MaritalStatus? @map("marital_status")
  bvn                String?
  nin                String?
  idType             IdType?        @map("id_type")
  idNumber           String?        @map("id_number")
  idIssueDate        DateTime?      @map("id_issue_date")
  idExpiryDate       DateTime?      @map("id_expiry_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientProfileId])
  @@index([tenantId])
  @@map("client_directors")
}

// Stored document reference. We don't host files — FE uploads to its
// configured storage (S3 / DO Spaces / etc.) and POSTs the resulting URL
// alongside the document type and scope. Adding a real upload pipeline is
// a follow-up that doesn't change this shape.
model ClientDocument {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  clientProfileId String              @map("client_profile_id")
  clientProfile   ClientProfile       @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type      ClientDocumentType
  scope     ClientDocumentScope
  // When scope = DIRECTOR, this carries the ClientDirector.id whose document
  // this is. No formal FK — kept loose so a director row can be replaced
  // without orphaning its docs (the FE is expected to clean up).
  scopeRefId String? @map("scope_ref_id")

  url      String
  fileName String? @map("file_name")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientProfileId, scope])
  @@index([tenantId])
  @@map("client_documents")
}

// Many-to-many: a client can focus on several commodities, and a commodity
// can be the focus of several clients. Composite-unique prevents duplicate
// rows for the same (client, commodity) pair.
model ClientFocusCommodity {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  clientProfileId String        @map("client_profile_id")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  commodityId     String        @map("commodity_id")
  commodity       Commodity     @relation(fields: [commodityId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([clientProfileId, commodityId])
  @@index([tenantId])
  @@index([commodityId])
  @@map("client_focus_commodities")
}

model Financier {
  id           String @id @default(uuid())
  name         String @unique
  interestRate Float  @map("interest_rate")
  minTenure    Int    @map("min_tenure")
  maxTenure    Int    @map("max_tenure")
  approvalTime String @map("approval_time")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  loans Loan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("financiers")
}

model WarehouseCommodity {
  id                String @id @default(uuid())
  warehouseId       String @map("warehouse_id")
  commodityId       String @map("commodity_id")
  storageFeePerUnit Float  @map("storage_fee_per_unit")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  commodity Commodity @relation(fields: [commodityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([warehouseId, commodityId])
  @@index([tenantId])
  @@map("warehouse_commodities")
}

model Withdrawal {
  id        String @id @default(uuid())
  reference String @unique

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  receiptId String  @map("receipt_id")
  receipt   Receipt @relation(fields: [receiptId], references: [id])

  clientId String @map("client_id")
  client   User   @relation(fields: [clientId], references: [id])

  quantity    Float
  reason      String?
  plannedDate DateTime         @map("planned_date")
  status      WithdrawalStatus @default(PENDING_PAYMENT)

  storageFee  Float @map("storage_fee")
  handlingFee Float @map("handling_fee")
  totalFee    Float @map("total_fee")

  // Extended fields from spec §1.0
  approvedById    String?   @map("approved_by_id")
  approvedBy      User?     @relation("WithdrawalApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  feesBilledAt    DateTime? @map("fees_billed_at")
  currency        String    @default("NGN")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([receiptId])
  @@index([status])
  @@index([tenantId])
  @@map("withdrawals")
}

model Loan {
  id        String @id @default(uuid())
  reference String @unique

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  receiptId String  @map("receipt_id")
  receipt   Receipt @relation(fields: [receiptId], references: [id])

  clientId String @map("client_id")
  client   User   @relation(fields: [clientId], references: [id])

  financierId String    @map("financier_id")
  financier   Financier @relation(fields: [financierId], references: [id])

  amount         Float
  interestRate   Float      @map("interest_rate")
  tenureMonths   Int        @map("tenure_months")
  totalInterest  Float      @map("total_interest")
  monthlyPayment Float      @map("monthly_payment")
  status         LoanStatus @default(PENDING)
  notes          String?
  currency       String     @default("NGN")

  approvedAt DateTime? @map("approved_at")
  repaidAt   DateTime? @map("repaid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([receiptId])
  @@index([financierId])
  @@index([status])
  @@index([tenantId])
  @@map("loans")
}

model Trade {
  id        String @id @default(uuid())
  reference String @unique

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  receiptId String  @map("receipt_id")
  receipt   Receipt @relation(fields: [receiptId], references: [id])

  sellerId String @map("seller_id")
  seller   User   @relation("TradeSeller", fields: [sellerId], references: [id])

  buyerId String? @map("buyer_id")
  buyer   User?   @relation("TradeBuyer", fields: [buyerId], references: [id])

  quantity     Float
  pricePerUnit Float       @map("price_per_unit")
  totalPrice   Float       @map("total_price")
  status       TradeStatus @default(LISTED)
  currency     String      @default("NGN")

  settledAt DateTime? @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([buyerId])
  @@index([receiptId])
  @@index([status])
  @@index([tenantId])
  @@map("trades")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Short-lived OTPs the client receives when 2FA-gated transactions are in
// flight. SHA-256 hash of the 6-digit code is stored (never the raw code).
// `attempts` counts wrong submissions so we can lock out a guessing bot
// without blocking the legitimate user from requesting a fresh code.
// `purpose` lets us pin a code to a specific transaction type — a withdrawal
// OTP can't be replayed against a loan and vice-versa.
model TransactionOtp {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String                @map("code_hash")
  purpose   TransactionOtpPurpose
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  attempts  Int                   @default(0)
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([userId, purpose, usedAt])
  @@map("transaction_otps")
}

// One row per outstanding password-reset request. `tokenHash` is the
// SHA-256 of the random token we emailed to the user; the raw token is
// never stored. Tokens are one-time use (`usedAt` flips on consumption)
// and short-lived (30 min) so the threat window stays small.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model ActivityLog {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id])

  action      String // e.g., "RECEIPT_APPROVED", "CLIENT_CREATED"
  entityType  String // e.g., "RECEIPT", "USER"
  entityId    String? // The ID of the target entity
  description String?
  metadata    Json? // Store payload or state diff

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([entityId])
  @@map("activity_logs")
}

// Per-user notification surface. Recipient is `userId`; broadcasting to a
// role/group is implemented service-side by fanning out one row per recipient
// so reads remain a single indexed lookup.
//   - `relatedEntityType` + `relatedEntityId` let the bell deep-link into
//     the receipt / withdrawal / loan / trade / client view.
//   - `data` is a small JSON blob for any extras the UI needs without a
//     schema migration (amount, counterparty name, etc.).
model Notification {
  id     String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String?

  relatedEntityType String? @map("related_entity_type")
  relatedEntityId   String? @map("related_entity_id")
  data              Json?

  isRead  Boolean   @default(false) @map("is_read")
  readAt  DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Explicit "this client is present at this warehouse" record. Prior to this
/// model, WM ↔ client visibility was implicit-via-receipts: the client only
/// appeared in a WM's list once they had a receipt in that WM's warehouse.
/// That worked for single-warehouse clients but blocked two workflows:
///   1. Onboarding a client into a warehouse BEFORE their first deposit
///      (WM wants to stage docs / bank info / focus commodities ahead of time)
///   2. Adding an existing client (already registered at another warehouse)
///      to a new warehouse via NIN/BVN lookup — the flow this model was
///      created for. See ManagersService.lookupClientByIdentifier +
///      AttachClientToWarehouse.
///
/// Detach semantics: `detachedAt` is nullable. Active attachment = null.
/// We never hard-delete rows so the audit trail (who attached, who detached,
/// when, why) survives forever. A soft-detach means the WM's list stops
/// showing the client, but their historical receipts at this warehouse
/// remain queryable (receipts are the source of truth for what happened;
/// attachments are the source of truth for what's currently in scope).
model ClientWarehouseAttachment {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  // The client user. FK to User (via ClientProfile.userId).
  clientId     String    @map("client_id")
  client       User      @relation("ClientAttachments", fields: [clientId], references: [id])

  warehouseId  String    @map("warehouse_id")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  // The WM who performed the attach — for audit + "attached by" surfacing
  // on the client's warehouse-detail view.
  attachedById String    @map("attached_by_id")
  attachedBy   User      @relation("AttachedByManager", fields: [attachedById], references: [id])
  attachedAt   DateTime  @default(now()) @map("attached_at")

  // Soft-detach. When populated, the client no longer appears in this
  // warehouse's client list, but the row survives for audit.
  detachedById String?   @map("detached_by_id")
  detachedBy   User?     @relation("DetachedByManager", fields: [detachedById], references: [id])
  detachedAt   DateTime? @map("detached_at")

  // Optional free-text note the WM can add at attach time (e.g. "moved
  // from Lagos to Ibadan branch") or at detach time (e.g. "client
  // relocated, no longer using this warehouse").
  reason       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // NOTE: the "only one ACTIVE attachment per (client, warehouse)" invariant
  // is enforced at the application layer in ManagersService.attachClient,
  // not via a partial unique index. Prisma doesn't natively support partial
  // indices in schema.prisma; adding one would require a raw SQL migration
  // and would complicate the re-attach-after-detach flow (which is common:
  // client moves out, moves back six months later — same (client, warehouse)
  // pair, new active row).
  @@index([clientId, warehouseId, detachedAt])
  @@index([warehouseId, tenantId, detachedAt])
  @@index([tenantId])
  @@map("client_warehouse_attachments")
}

/// Audit trail for the NIN/BVN lookup endpoint. Written on EVERY lookup —
/// hit or miss, in-scope or out-of-scope — so we have forensic evidence
/// if a WM starts using the endpoint to enumerate identifiers.
///
/// Storage: identifier is HASHED (sha256) never raw. This gives us the
/// audit ability ("was this NIN looked up 40 times last week?") without
/// concentrating PII in the audit log itself. If a specific NIN needs to
/// be traced, the tenant admin can hash it and query.
model ClientLookupAudit {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  // The WM who performed the lookup.
  managerId      String   @map("manager_id")
  manager        User     @relation("LookupAuditor", fields: [managerId], references: [id])

  // The warehouse the WM was signed into at lookup time (for cross-referencing
  // "which warehouse's staff is enumerating identifiers"). Nullable because
  // some future flow might allow lookup without an active warehouse session.
  warehouseId    String?   @map("warehouse_id")
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])

  identifierType String   @map("identifier_type") // 'NIN' | 'BVN'
  identifierHash String   @map("identifier_hash") // sha256 of the identifier

  // What happened: FOUND_IN_SCOPE (already visible), FOUND_ELSEWHERE
  // (exists in tenant, not yet attached), NOT_FOUND (no match at all).
  result         String

  // The client that matched, if any. Nullable when NOT_FOUND.
  matchedClientId String? @map("matched_client_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([managerId, createdAt])
  @@index([tenantId, createdAt])
  @@index([identifierHash])
  @@map("client_lookup_audits")
}

// ═══════════════════════════════════════════════════════════════════════════
// COLLATERAL FLOW — Financier / Pledge / Lien / Release
// ═══════════════════════════════════════════════════════════════════════════
//
// The collateral flow lets a client pledge (part of) a receipt to a
// financier (bank / FI) as collateral for an off-system loan. Volume
// accounting is tracked by the UTXO-style receipt tree already used by
// withdrawals and legacy loans — a pledge holds a child receipt in the
// HELD_PLEDGE_PENDING state; acceptance transitions to HELD_LIEN;
// release/expire returns to ACTIVE.
//
// Contract: FE types at src/api/types/collateral.ts. Every enum literal
// and field name below matches the FE's parser exactly — coordinate
// renames.
//
// Rationale for keeping the legacy Financier + Loan models untouched:
// the collateral flow is semantically different (no loan math, no
// interest/tenure) but the /loans/* endpoints stay live for the
// existing product surface. We add FinancierOrg alongside; migrating
// loans to the new model is a v2 concern.

/// The bank / financial institution that receives pledges and holds liens.
/// One FinancierOrg has many financier-role users (see User.financierOrgId).
/// Provisioned by Tenant Admin via a new "Add financier org" screen.
model FinancierOrg {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  tenant        Tenant @relation(fields: [tenantId], references: [id])

  name          String
  licenseNumber String? @map("license_number")
  // Signed license certificate / master agreement uploaded at create time
  // (via POST /storage/upload?kind=LICENSE_DOC). Optional — a TA can add
  // it later via the same modal in edit mode. Storing here so the TA's
  // Financiers table can render a "view license" affordance without an
  // extra join.
  licenseDocUrl String? @map("license_doc_url")
  logoUrl       String? @map("logo_url")

  status        FinancierOrgStatus @default(ACTIVE)

  // Per-org override of the pledge TTL. Null = fall back to the system
  // default (env var PLEDGE_TTL_DAYS, currently 7). When a client submits
  // a pledge, the server reads this field on the target FinancierOrg
  // and computes expiresAt = createdAt + (this ?? default) days.
  pledgeTtlDays Int? @map("pledge_ttl_days")

  users            User[]           @relation("FinancierOrgUsers")
  warehouseLinks   WarehouseLink[]
  pledges          Pledge[]
  liens            Lien[]
  releaseRequests  ReleaseRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([status])
  @@map("financier_orgs")
}

/// A signed agreement between a FinancierOrg and a Warehouse allowing
/// clients of that warehouse to pledge receipts to that financier.
/// Financier-initiated onboarding (uploads agreement doc) → PENDING;
/// Tenant Admin reviews and moves to ACTIVE (or hard-deletes on reject —
/// no REJECTED status in v1 per Q3). Offboarding is blocked while any
/// active lien exists in that warehouse.
model WarehouseLink {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  financierOrgId String       @map("financier_org_id")
  financierOrg   FinancierOrg @relation(fields: [financierOrgId], references: [id])

  warehouseId    String       @map("warehouse_id")
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])

  status         WarehouseLinkStatus @default(PENDING)

  agreementDocUrl String?  @map("agreement_doc_url")
  signedAt        DateTime? @map("signed_at")

  // Who submitted the onboarding request (financier-role user).
  createdById   String @map("created_by_id")
  createdBy     User   @relation("WarehouseLinkCreator", fields: [createdById], references: [id])

  // Who approved / offboarded (Tenant Admin for approval; either party
  // can offboard as long as no active liens exist).
  decidedById    String?   @map("decided_by_id")
  decidedBy      User?     @relation("WarehouseLinkDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime? @map("decided_at")
  decisionReason String?   @map("decision_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Only one ACTIVE-track link per (financier, warehouse) pair. Enforced
  // application-side because Prisma doesn't cleanly support partial
  // unique indexes; we check "no non-OFFBOARDED row exists" before
  // creating a new PENDING.
  @@index([financierOrgId, warehouseId, status])
  @@index([warehouseId, status])
  @@index([tenantId, status])
  @@map("warehouse_links")
}

/// Client's request to pledge (part of) a receipt as collateral. The
/// pledged volume is held out of `available` immediately (into a child
/// receipt with HELD_PLEDGE_PENDING) and either transitions to a Lien
/// on accept or returns to ACTIVE on reject/expire/cancel.
///
/// `receiptId` points to the ROOT receipt (what the client sees in their
/// list). `heldReceiptId` points to the CHILD receipt that carries the
/// held-pending volume — used by the ledger to release/transition. This
/// split lets the FE render "pledge on RCP-0042" without exposing the
/// tree-child implementation detail.
model Pledge {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  // Root receipt — the client-visible one.
  receiptId      String       @map("receipt_id")
  receipt        Receipt      @relation("PledgeReceipt", fields: [receiptId], references: [id])

  // Held child receipt (leaf carrying the pledged volume). Populated at
  // creation. On accept, this leaf transitions HELD_PLEDGE_PENDING →
  // HELD_LIEN and becomes the Lien's receipt too.
  heldReceiptId  String?      @unique @map("held_receipt_id")
  heldReceipt    Receipt?     @relation("PledgeHeldReceipt", fields: [heldReceiptId], references: [id])

  clientId       String       @map("client_id")
  client         User         @relation("ClientPledges", fields: [clientId], references: [id])

  financierOrgId String       @map("financier_org_id")
  financierOrg   FinancierOrg @relation(fields: [financierOrgId], references: [id])

  warehouseId    String       @map("warehouse_id")
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])

  // Volume + unit snapshot at pledge time. Unit is snapshotted so a later
  // commodity unit change (e.g. rename MT → METRIC_TON) doesn't retro-
  // active the pledge's display.
  quantity Decimal @db.Decimal(20, 4)
  unit     String

  // Reference-only display value; NOT used for any lending / eligibility
  // math per §8 non-goals. Populated per Q2 answer via the automatic
  // CommodityPrice lookup at pledge time (with fallback to null if no
  // price is available for this commodity).
  valuationAtPledge Decimal? @db.Decimal(20, 2) @map("valuation_at_pledge")
  currency          String   @default("NGN")

  status         PledgeStatus @default(PENDING)
  clientNote     String?      @map("client_note")

  decisionReason String?      @map("decision_reason")
  decidedById    String?      @map("decided_by_id")
  decidedBy      User?        @relation("PledgeDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?    @map("decided_at")

  // Computed at creation: createdAt + (financierOrg.pledgeTtlDays ??
  // env PLEDGE_TTL_DAYS ?? 7) days. Cron scans for status=PENDING and
  // expiresAt <= now(), transitions to EXPIRED and releases volume.
  expiresAt DateTime @map("expires_at")

  // Backlink to the resulting lien (populated on accept).
  lien Lien?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([clientId, status])
  @@index([financierOrgId, status])
  @@index([status, expiresAt])
  @@map("pledges")
}

/// An active claim by a FinancierOrg on a specific volume of a receipt.
/// Created atomically when a Pledge is accepted. Decrements on approved
/// ReleaseRequests. Terminal states: RELEASED (fully returned), or
/// FORCE_RELEASED (Global Admin override with court order).
///
/// `receiptId` here is the CHILD leaf holding the liened volume (unlike
/// Pledge.receiptId which is the root). The two are equal at creation
/// (accepted pledge's heldReceipt IS the lien's receipt), but partial
/// releases can further subdivide.
model Lien {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  pledgeId       String       @unique @map("pledge_id")
  pledge         Pledge       @relation(fields: [pledgeId], references: [id])

  receiptId      String       @map("receipt_id")
  receipt        Receipt      @relation(fields: [receiptId], references: [id])

  clientId       String       @map("client_id")
  client         User         @relation("ClientLiens", fields: [clientId], references: [id])

  financierOrgId String       @map("financier_org_id")
  financierOrg   FinancierOrg @relation(fields: [financierOrgId], references: [id])

  // `quantity` — the original locked amount (never mutates; audit-safe).
  // `remainingQuantity` — the still-liened amount; decrements on each
  // approved release. When 0, status transitions to RELEASED.
  quantity          Decimal @db.Decimal(20, 4)
  remainingQuantity Decimal @db.Decimal(20, 4) @map("remaining_quantity")

  status     LienStatus @default(ACTIVE)
  placedAt   DateTime   @default(now()) @map("placed_at")
  releasedAt DateTime?  @map("released_at")

  releaseLines ReleaseRequestLine[]
  forceRelease ForceRelease?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([clientId, status])
  @@index([financierOrgId, status])
  @@index([receiptId])
  @@map("liens")
}

/// Client's request to release (part of) one or more liens. Multi-line —
/// a single request can target several liens from the same financier
/// (all lines must share `financierId`). Approval is all-or-nothing per
/// request in v1 (§1.3): financier approves everything or rejects the
/// whole thing (client re-submits corrected).
model ReleaseRequest {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  clientId       String       @map("client_id")
  client         User         @relation("ClientReleaseRequests", fields: [clientId], references: [id])

  financierOrgId String       @map("financier_org_id")
  financierOrg   FinancierOrg @relation(fields: [financierOrgId], references: [id])

  // Client's requested release date. Informational — actual release
  // happens whenever the financier approves. Not a hard deadline.
  requestedDate DateTime @map("requested_date")
  note          String?

  status         ReleaseRequestStatus @default(PENDING)
  decisionReason String?              @map("decision_reason")
  decidedById    String?              @map("decided_by_id")
  decidedBy      User?                @relation("ReleaseRequestDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?            @map("decided_at")

  lines ReleaseRequestLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([clientId, status])
  @@index([financierOrgId, status])
  @@map("release_requests")
}

/// One line item within a ReleaseRequest — targets a specific lien with
/// a specific quantity. `receiptId` denormalised for FE query efficiency
/// (avoids join through Lien for the release-request listing).
model ReleaseRequestLine {
  id String @id @default(uuid())

  releaseRequestId String         @map("release_request_id")
  releaseRequest   ReleaseRequest @relation(fields: [releaseRequestId], references: [id], onDelete: Cascade)

  lienId    String  @map("lien_id")
  lien      Lien    @relation(fields: [lienId], references: [id])

  receiptId String  @map("receipt_id")
  receipt   Receipt @relation(fields: [receiptId], references: [id])

  quantity  Decimal @db.Decimal(20, 4)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([releaseRequestId])
  @@index([lienId])
  @@map("release_request_lines")
}

/// Immutable Global-Admin override that terminates a lien outside the
/// normal accept/release flow — only permitted with a court order.
/// Required fields: reason (free-text) + courtOrderDocUrl (via /storage/
/// upload?kind=COURT_ORDER). No updated_at — this row is append-only.
model ForceRelease {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  lienId String @unique @map("lien_id")
  lien   Lien   @relation(fields: [lienId], references: [id])

  adminId String @map("admin_id")
  admin   User   @relation("ForceReleaseAdmin", fields: [adminId], references: [id])

  reason           String
  courtOrderDocUrl String @map("court_order_doc_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([adminId])
  @@map("force_releases")
}

/// Latest reference price per commodity per tenant, used to fill
/// Pledge.valuationAtPledge automatically at pledge creation time
/// (per Q2 answer: automatic per current market data).
///
/// v1 impl: manual admin-updated rows. Tenant Admin sets prices in an
/// admin screen; each pledge picks up the latest row for its commodity.
///
/// v2+ (planned): a scheduled sync job pulls prices from an external
/// feed (NCX, Trading Economics, etc.) and inserts rows with source ≠
/// "MANUAL". The pledge-time lookup logic doesn't need to know about
/// the sync — it just reads the latest effective row.
///
/// Multiple rows per commodity are expected (historical prices survive)
/// so we ORDER BY effectiveAt DESC + LIMIT 1 to pick the current one.
model CommodityPrice {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  commodityId String    @map("commodity_id")
  commodity   Commodity @relation(fields: [commodityId], references: [id])

  // The unit this price is denominated per. Should match the commodity's
  // unitOfMeasure but stored as a string for future flexibility (e.g. a
  // per-bag price on a commodity denominated in KG).
  unit String

  pricePerUnit Decimal @db.Decimal(20, 2) @map("price_per_unit")
  currency     String  @default("NGN")

  // Who set the price and when it takes effect. `effectiveAt` allows
  // scheduling future price changes (insert now, effective tomorrow —
  // the lookup won't pick it up until tomorrow).
  setById     String   @map("set_by_id")
  setBy       User     @relation("PriceSetter", fields: [setById], references: [id])
  effectiveAt DateTime @map("effective_at")

  // Provenance tag for later cross-referencing (audit, "which feed
  // gave us this price"). Free text for v1 flexibility — later can
  // become an enum once the sync mechanism is picked.
  source String @default("MANUAL")

  createdAt DateTime @default(now()) @map("created_at")

  // The lookup query is:
  //   ORDER BY effectiveAt DESC LIMIT 1
  //   WHERE tenantId = ? AND commodityId = ? AND effectiveAt <= now()
  // This composite index makes that a single index scan.
  @@index([tenantId, commodityId, effectiveAt(sort: Desc)])
  @@map("commodity_prices")
}

